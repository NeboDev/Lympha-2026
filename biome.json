{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/*.md",
      "!openspec",
      "!.claude",
      "!pnpm-lock.yaml",
      "!**/migrations/meta"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/server/src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*/*", "!../*/index.ts"],
                    "message": "Un módulo solo importa la interfaz pública de otro (modules/<x>/index.ts)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/main/**",
        "apps/server/src/cli/**",
        "apps/server/src/platform/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../modules/*/*", "!../modules/*/index.ts"],
                    "message": "Un módulo solo importa la interfaz pública de otro (modules/<x>/index.ts)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
