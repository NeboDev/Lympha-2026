# Atl web — variables públicas (llegan al navegador: NUNCA pongas aquí secretos del servidor).
# Cópialo a .env y llénalo. Los valores de Firebase salen de:
#   consola de Firebase > Configuración del proyecto > General > Tus apps > firebaseConfig

# URL de la API de Atl (el servidor de hackathon/server; su PORT). Sin barra final.
VITE_API_URL=http://localhost:3000

# Firebase (acceso con Google)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Solo para el plan B de la demo (servidor con APP_ENV=demo y USUARIO_DEMO_ACTIVO=true): el mismo valor de
# USUARIO_DEMO_TOKEN del servidor. Va dentro del JavaScript que ve el navegador: quien abra la web lo puede leer.
# Déjalo vacío si no usas el plan B.
VITE_DEMO_TOKEN=
