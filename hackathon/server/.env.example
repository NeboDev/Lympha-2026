# Atl — variables de entorno (solo nombres; los valores van en .env, que NO se versiona)

APP_ENV=local                 # local | demo
PORT=3000
CORS_ORIGINS=http://localhost:5173

# MongoDB: Atlas (mongodb+srv://...) o local en Docker (mongodb://127.0.0.1:27017/atl)
MONGODB_URI=
MONGODB_DB=atl
# Opcional: DNS alternos separados por coma si el DNS local no resuelve mongodb+srv (error querySrv ECONNREFUSED)
MONGODB_DNS=

# Blynk
BLYNK_HOST=blynk.cloud        # o el regional (fra1.blynk.cloud, etc.)
POLL_MS=5000                  # 5000 en la demo, 30000 en uso normal
INGESTA_ACTIVA=true           # false = solo la API, sin sondear Blynk
SIN_DATOS_S=60                # sin seq nuevo por este tiempo => alerta "sin conexión"
# Token del dispositivo de prueba: solo para el Paso 0, el simulador y las pruebas.
# En producción el token de cada nodo se guarda cifrado en Mongo, no aquí.
BLYNK_TOKEN_PRUEBA=

# Cifrado del token de Blynk (32 bytes en base64: openssl rand -base64 32)
ATL_CLAVE_CIFRADO=

# Firebase (sesión con Google). El servidor solo verifica tokens.
FIREBASE_PROJECT_ID=
FIREBASE_USE_EMULATOR=false
# FIREBASE_SERVICE_ACCOUNT es opcional

# Telegram (bot creado con @BotFather). Sin token, los avisos esperan en la bandeja.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=        # sin @, p. ej. lympha26_bot (se usa para los enlaces de vinculación)
RECORDATORIO_MIN=30           # minutos entre recordatorios de una alerta abierta (la mitad si es crítica)
BARRIDO_MS=15000              # cada cuánto se revisan recordatorios y avisos pendientes de enviar

# Demo
USUARIO_DEMO_ACTIVO=false     # true = permite el usuario de demostración fijo (solo APP_ENV=demo)
