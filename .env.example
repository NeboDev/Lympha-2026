# Copia este archivo a .env (no se versiona) y pon tus valores. Solo lo lee Compose de desarrollo.
# Bot de desarrollo: @lympha_dev_bot. Proyecto de Firebase: lympha-dev (en local se usa su emulador de Auth).

# Token del bot (BotFather). Lo usan la API (vinculación: /start <token>, /desvincular) y el notifier (envío de avisos).
# Sin él, Telegram queda desactivado: no se puede vincular y los avisos esperan en la bandeja de salida.
TELEGRAM_BOT_TOKEN=

# Solo si expones la API con un túnel (ngrok, cloudflared): activa el webhook en vez de long polling.
# Debe ser https. El secreto: 16 a 256 caracteres A-Za-z0-9_-
PUBLIC_API_URL=
TELEGRAM_WEBHOOK_SECRET=

# Orígenes de la PWA a los que la API responde por CORS (separados por coma, sin barra final).
# Por defecto, el servidor de desarrollo de Vite (apps/web) y `vite preview` (el build con su service worker).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173

# true = emulador local; false = proyecto real lympha-dev
FIREBASE_USE_EMULATOR=true
FIREBASE_SERVICE_ACCOUNT=