# Copia a apps/web/.env.local (no se versiona). Todas son públicas: llegan al navegador; nunca pongas secretos aquí.

# URL de la API. En desarrollo, por defecto http://127.0.0.1:3000 (la API de pnpm dev).
VITE_API_URL=

# Firebase Auth. En desarrollo (pnpm web) no hace falta nada: usa el emulador de pnpm dev (127.0.0.1:9099) y el
# proyecto lympha-dev. El emulador SOLO existe en desarrollo: un build de producción lo ignora.
# Para entrar contra el proyecto real lympha-dev, pon VITE_FIREBASE_AUTH_EMULATOR=off y la llave web del proyecto
# (Configuración del proyecto → tus apps → apiKey; es pública por diseño de Firebase). La API debe tener
# FIREBASE_USE_EMULATOR=false.
VITE_FIREBASE_AUTH_EMULATOR=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
