{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Mexico_City",
  "labels": ["dependencias"],
  "packageRules": [
    {
      "description": "Parches con el CI en verde se mezclan solos (plan: merge automático de parches).",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Versiones mayores fijadas por el plan: no subir de mayor sin decisión.",
      "matchPackageNames": [
        "typescript",
        "zod",
        "pino",
        "bullmq",
        "fastify-type-provider-zod",
        "node"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
