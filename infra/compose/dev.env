# Valores SOLO para desarrollo local. No son secretos reales: no se usan en staging ni producción
# (ahí las variables vienen de infra/secrets/*.enc.env, cifradas con SOPS).
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug

# Postgres: superusuario del contenedor y contraseñas de los roles (init-roles.sh)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-postgres-superuser
POSTGRES_DB=lympha
PW_OWNER=dev-owner
PW_APP=dev-app
PW_SYSTEM=dev-system
PW_BACKUP=dev-backup
DATABASE_URL_MIGRATE=postgres://lympha_owner:dev-owner@postgres:5432/lympha
DATABASE_URL_APP=postgres://lympha_app:dev-app@postgres:5432/lympha
DATABASE_URL_SYSTEM=postgres://lympha_system:dev-system@postgres:5432/lympha

# Valkey: un usuario por proceso
VALKEY_PW_API=dev-valkey-api
VALKEY_PW_INGEST=dev-valkey-ingest
VALKEY_PW_WORKER=dev-valkey-worker

# Mosquitto: procesos internos por el 1883 (sin TLS, red de Docker)
MQTT_URL=mqtt://mosquitto:1883
MQTT_ADMIN_USER=lympha-admin
MQTT_ADMIN_PASSWORD=dev-mqtt-admin
MQTT_INGEST_USER=lympha-ingest
MQTT_INGEST_PASSWORD=dev-mqtt-ingest
MQTT_CONTROL_USER=lympha-control
MQTT_CONTROL_PASSWORD=dev-mqtt-control

# Pepper del hash del código de reclamo
CLAIM_PEPPER=dev-claim-pepper

# Nodo de desarrollo (db:seed y simulador)
DEV_NODO_ID=0192f3a7-5d1c-7a2b-8c3d-000000000001
DEV_NODO_PASSWORD=dev-nodo-password
DEV_NODO_CODIGO=DEV-CLAIM-0001
