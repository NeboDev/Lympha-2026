# Sobrescribe dev.env para los comandos que corren en TU equipo (no en Compose): factory, dev:token, seed y el
# simulador. Los servicios de Compose usan los nombres internos (postgres, mosquitto...); desde el host se llega
# por los puertos publicados en 127.0.0.1. Se carga DESPUÉS de dev.env:  node --env-file=dev.env --env-file=host.env
DATABASE_URL_MIGRATE=postgres://lympha_owner:dev-owner@127.0.0.1:5432/lympha
DATABASE_URL_APP=postgres://lympha_app:dev-app@127.0.0.1:5432/lympha
DATABASE_URL_SYSTEM=postgres://lympha_system:dev-system@127.0.0.1:5432/lympha
MQTT_URL=mqtt://127.0.0.1:1883
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
