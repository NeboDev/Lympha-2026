# Plantilla de variables de un entorno desplegado (staging / production). Copia, rellena y cifra con SOPS
# (ver README.md). Valores generados: `openssl rand -hex 24`. Sin comillas ni espacios.

APP_ENV=staging
LOG_LEVEL=info

# Dominios (Caddy emite los certificados) y correo para Let's Encrypt
API_DOMAIN=api.staging.lympha.app
MQTT_DOMAIN=mqtt.staging.lympha.app
ACME_EMAIL=admin@example.com

# Postgres: superusuario del contenedor y contraseñas de los roles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lympha
PW_OWNER=
PW_APP=
PW_SYSTEM=
PW_BACKUP=

# Valkey: un usuario ACL por proceso
VALKEY_PW_API=
VALKEY_PW_INGEST=
VALKEY_PW_WORKER=

# Mosquitto: cliente de administración y clientes internos (el nombre de usuario es libre)
MQTT_ADMIN_USER=lympha-admin
MQTT_ADMIN_PASSWORD=
MQTT_INGEST_USER=lympha-ingest
MQTT_INGEST_PASSWORD=
MQTT_CONTROL_USER=lympha-control
MQTT_CONTROL_PASSWORD=

# Pepper del hash del código de reclamo (no cambiarlo después: invalida los códigos de los nodos)
CLAIM_PEPPER=

# Memoria de Postgres según el tamaño del servidor (staging 4 GB: 1GB/3GB; producción 8 GB: 2GB/5GB)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MEM_LIMIT=3g

# Llegan en H1-H3: FIREBASE_PROJECT_ID, FIREBASE_SERVICE_ACCOUNT, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
# S3_*, SENTRY_DSN
