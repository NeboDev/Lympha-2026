# Plantilla de variables de un entorno desplegado (staging / production). Copia, rellena y cifra con SOPS
# (ver README.md). Valores generados: `openssl rand -hex 24`. Sin comillas ni espacios.

APP_ENV=staging
LOG_LEVEL=info

# Dominios (Caddy emite los certificados) y correo para Let's Encrypt
API_DOMAIN=api.staging.lympha.app
MQTT_DOMAIN=mqtt.staging.lympha.app
ACME_EMAIL=admin@example.com

# Postgres: superusuario del contenedor y contraseñas de los roles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lympha
PW_OWNER=
PW_APP=
PW_SYSTEM=
PW_BACKUP=

# Valkey: un usuario ACL por proceso
VALKEY_PW_API=
VALKEY_PW_INGEST=
VALKEY_PW_WORKER=

# Mosquitto: cliente de administración y clientes internos (el nombre de usuario es libre)
MQTT_ADMIN_USER=lympha-admin
MQTT_ADMIN_PASSWORD=
MQTT_INGEST_USER=lympha-ingest
MQTT_INGEST_PASSWORD=
MQTT_CONTROL_USER=lympha-control
MQTT_CONTROL_PASSWORD=

# Pepper del hash del código de reclamo (no cambiarlo después: invalida los códigos de los nodos)
CLAIM_PEPPER=

# Memoria de Postgres según el tamaño del servidor (staging 4 GB: 1GB/3GB; producción 8 GB: 2GB/5GB)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MEM_LIMIT=3g

# Proyecto de Firebase cuyos tokens acepta la API (staging: el proyecto de staging)
FIREBASE_PROJECT_ID=
# Opcional: cuenta de servicio en base64 (verificar tokens no la necesita). Debe ser de FIREBASE_PROJECT_ID.
FIREBASE_SERVICE_ACCOUNT=

# PWA (H4): origen desde el que el navegador llama a la API (https://app.<dominio>, sin barra final; varios, separados por coma).
CORS_ORIGINS=

# Telegram (H3). El bot de cada entorno es distinto. En staging y producción el bot usa webhook:
# PUBLIC_API_URL (https://api.<dominio>) y TELEGRAM_WEBHOOK_SECRET (16 a 256 caracteres A-Za-z0-9_-) son obligatorios
# si hay token. Sin token, la API no recibe mensajes del bot y el notifier acumula los avisos sin enviarlos.
TELEGRAM_BOT_TOKEN=
PUBLIC_API_URL=
TELEGRAM_WEBHOOK_SECRET=

# Llegan en H6: S3_*, SENTRY_DSN
