{
  "name": "lympha",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "docker compose --env-file .env -f infra/compose/base.yml -f infra/compose/dev.yml up --build --watch",
    "web": "pnpm --filter @lympha/web dev",
    "web:build": "pnpm --filter @lympha/web build",
    "test:e2e": "pnpm --filter @lympha/web test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration --passWithNoTests",
    "migrate": "pnpm --filter @lympha/server migrate",
    "db:seed": "pnpm --filter @lympha/server db:seed",
    "factory": "node --env-file=infra/compose/dev.env --env-file=infra/compose/host.env apps/server/src/cli/fabrica.ts",
    "dev:emulador": "docker compose --env-file .env --profile emulador -f infra/compose/base.yml -f infra/compose/dev.yml up --build --watch",
    "dev:telegram": "node --env-file=infra/compose/dev.env --env-file=infra/compose/host.env apps/server/src/cli/probar-telegram.ts",
    "dev:token": "node --env-file=infra/compose/dev.env --env-file=infra/compose/host.env apps/server/src/cli/dev-token.ts",
    "ota": "node --env-file=infra/compose/dev.env --env-file=infra/compose/host.env --env-file-if-exists=.env apps/server/src/cli/ota.ts",
    "certs": "node scripts/certs.mjs",
    "simulator": "node --env-file=infra/compose/dev.env tools/simulator/src/cli.ts --url mqtts://localhost:8883 --ca infra/certs/ca.crt",
    "test:infra": "bash infra/test/deploy.test.sh && bash infra/test/prod-compose.test.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
